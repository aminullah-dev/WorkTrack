<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Declared by the feature that needs them rather than only by the app, so
      the module is correct on its own and any consumer inherits them:
      location stamps a punch, the camera reads kiosk QR codes and runs the
      on-device face check.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />

</manifest>
