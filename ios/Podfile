# TensorFlow Lite for iOS is still CocoaPods-first (LiteRT's SPM support covers
# other components, not this one), so this one dependency comes through a
# Podfile while everything else stays XcodeGen.
#
#   cd ios && xcodegen generate && pod install && open WorkTrack.xcworkspace
#
# The WORKSPACE is what you open from here on; the bare .xcodeproj no longer
# links the pod.
platform :ios, '16.0'
use_frameworks!

target 'WorkTrack' do
  # The same interpreter the Android app uses, so the same model file produces
  # the same vector. Anything else — Vision's own face descriptors, a converted
  # Core ML model — lands in a different space, and an employee enrolled on
  # Android simply stops being recognised.
  pod 'TensorFlowLiteSwift', '~> 2.17.0'

  target 'WorkTrackTests' do
    inherit! :search_paths
  end
end
