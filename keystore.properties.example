# Copy to keystore.properties and fill in. That file is gitignored and must stay
# that way — it holds the password to the release signing key.
#
# Create the key once, outside the repo if you prefer:
#   keytool -genkeypair -v -keystore worktrack-release.jks \
#     -alias worktrack -keyalg RSA -keysize 4096 -validity 10000
#
# Then back the .jks up somewhere durable. If it is lost, this app can never be
# updated again — a new key means a new listing and every user reinstalling.

storeFile=worktrack-release.jks
storePassword=
keyAlias=worktrack
keyPassword=
