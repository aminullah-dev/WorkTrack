# Copy to .env.local and fill in from your Firebase project settings.
# All VITE_-prefixed vars are exposed to the client bundle (public config only).

# REST API base URL. Local Functions emulator by default:
VITE_API_BASE_URL=http://127.0.0.1:5001/worktrack-dev/us-central1/api/v1

# Firebase web app config (Project settings -> Your apps -> Web app):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
