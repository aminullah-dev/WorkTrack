<?xml version="1.0" encoding="utf-8"?>
<!-- Tenant data must never leave the device via cloud backup: the Room database
     and session DataStore hold attendance, payroll, and identity records. -->
<full-backup-content>
    <exclude domain="database" path="worktrack.db" />
    <exclude domain="file" path="datastore/" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
